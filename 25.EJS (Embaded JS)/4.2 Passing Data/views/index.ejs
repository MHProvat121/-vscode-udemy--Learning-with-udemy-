<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Name Letters</title>
</head>

<body>
  <!-- Write your code here -->
   <!--every "line", wants to be view as ejs -should be evaluated, in ejs symbol-->
   <!--locals or res.locals = is used to chaeck if  a variable is present in a js file-->
   <% if (locals.numberOfLetters){ %>
    <h1>there are <%= numberOfLetters %> letters in your name</h1>
<% } else{ %>
  <h1>Write your name below</h1>
  <% } %>

   
  <form action="/submit" method="POST">
    <input type="text" name="fName" placeholder="First name">
    <input type="text" name="lName" placeholder="Last name">
    <input type="submit" value="OK">
  </form>
</body>

</html>